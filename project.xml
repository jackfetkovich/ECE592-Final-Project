<mujoco model="auv_in_fluid">
    <!-- Density and Viscosity tuned to represent fluid environment -->
    <option timestep="0.0001" density="1000" viscosity="1e-6" cone="elliptic" noslip_iterations="3"/>

    <asset>
    <!-- Floor Asset Definition -->
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3"
        rgb2=".2 .3 .4" width="300" height="300" mark="edge" markrgb=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="2 2" texuniform="true"
        reflectance=".2"/>
    </asset>

    <!-- SeaWolf IX xml model -->
    <worldbody>
        <light name="top" pos="0 0 10"/>
        <geom size="10 10 .01" type="plane" material="grid"/>
        <body name="SWIX" pos="0 0 5">
            <freejoint name="SWIX_freejoint"/>
            <!-- AUV Frame -->
            <geom name="red_box" type="box" size=".2 .5 .2" rgba="1 0 0 1" pos="0 0 0" mass="100"/>

            <!-- Vertical Thrusters -->
            <geom name="thruster_1" type="cylinder" size=".1 .1" rgba="0 0 0 1" pos=".3 .25 0" mass=".1"/>
            <site name="thrust1_site" pos=".3 .25 0"/>
            <geom name="thruster_2" type="cylinder" size=".1 .1" rgba="0 0 0 1" pos=".3 -.25 0" mass=".1"/>
            <site name="thrust2_site" pos=".3 -.25 0"/>
            <geom name="thruster_3" type="cylinder" size=".1 .1" rgba="0 0 0 1" pos="-.3 .25 0" mass=".1"/>
            <site name="thrust3_site" pos="-.3 .25 0"/>
            <geom name="thruster_4" type="cylinder" size=".1 .1" rgba="0 0 0 1" pos="-.3 -.25 0" mass=".1"/>
            <site name="thrust4_site" pos="-.3 -.25 0"/>

            <!-- Diagonal Thrusters -->
            <body name="thruster_5" pos=".3 .5 0" euler="90 45 0">
                <geom type="cylinder" size=".1 .1" rgba="0 0 0 1" mass=".1"/>
                <site name="thrust5_site"/>
            </body>
            <body name="thruster_6" pos="-.3 .5 0" euler="90 -45 0">
                <geom type="cylinder" size=".1 .1" rgba="0 0 0 1" mass=".1"/>
                <site name="thrust6_site"/>
            </body>
            <body name="thruster_7" pos=".3 -.5 0" euler="90 -45 0">
                <geom type="cylinder" size=".1 .1" rgba="0 0 0 1" mass=".1"/>
                <site name="thrust7_site"/>
            </body>                
            <body name="thruster_8" pos="-.3 -.5 0" euler="90 45 0">
                <geom type="cylinder" size=".1 .1" rgba="0 0 0 1" mass=".1"/>
                <site name="thrust8_site"/>
            </body>

        </body>

    </worldbody>

    <actuator>

        <!-- Need to change values based on thruster matrix and maybe change the joints to sites -->

        <!-- Vertical thrusters -->
        <motor name="thrust1" joint="SWIX_freejoint" gear="0 0 1 0 0 0"/>
        <motor name="thrust2" joint="SWIX_freejoint" gear="0 0 1 0 0 0"/>
        <motor name="thrust3" joint="SWIX_freejoint" gear="0 0 1 0 0 0"/>
        <motor name="thrust4" joint="SWIX_freejoint" gear="0 0 1 0 0 0"/>

        <!-- Diagonal thrusters -->
        <motor name="thrust5" joint="SWIX_freejoint" gear="0 0 0 0 0 1"/>
        <motor name="thrust6" joint="SWIX_freejoint" gear="0 0 0 0 0 -1"/>
        <motor name="thrust7" joint="SWIX_freejoint" gear="0 0 0 0 0 -1"/>
        <motor name="thrust8" joint="SWIX_freejoint" gear="0 0 0 0 0 1"/>
    </actuator>


</mujoco>