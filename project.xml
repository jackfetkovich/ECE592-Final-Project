<mujoco model="project">
    <actuator>
        <!-- Front Diagonal Thrusters -->
        <motor name="thrust0" site="thrust0_site" gear=".4472 -.8944 0 0 0 0" />
        <motor name="thrust1" site="thrust1_site" gear=".4473 .8944 0 0 0 0" />

        <!-- Right Vertical Thrusters -->
        <motor name="thrust2" site="thrust2_site" gear="0 0 -1  0 0 0" />
        <motor name="thrust3" site="thrust3_site" gear="0 0 -1  0 0 0" />

        <!-- Back Diagonal Thrusters -->
        <motor name="thrust4" site="thrust4_site" gear=".4473 -.8944 0 0 0 0" />
        <motor name="thrust5" site="thrust5_site" gear=".4473 .8944 0 0 0 0" />

        <!-- Left Vertical Thrusters -->
        <motor name="thrust6" site="thrust6_site" gear="0 0 -1 0 0 0" />
        <motor name="thrust7" site="thrust7_site" gear="0 0 -1 0 0 0" />

    </actuator>

    <sensor>
        <framepos name="body_pos" objtype="site" objname="imu"/>
        <framequat name="body_orientation" objtype="site" objname="imu"/>
        <framelinvel name="body_linvel" objtype="site" objname="imu"/>
        <frameangvel name="body_angvel" objtype="site" objname="imu"/>
   </sensor>
   
</mujoco>